# GSRS MCP Server runtime configuration
#
# Both docker-compose.yaml and podman-kube-play.yaml read their values
# from this file. Every key listed below is referenced from the manifest
# as a bare ${VAR}; stock `envsubst` is enough to render either file.
#
# App-level configuration (EMBEDDING_*, MCP_*, GSRS_API_*, CHUNKER_*,
# DEBUG_MODE, ...) is OPTIONAL — if a key is unset, the corresponding
# value in the manifest becomes an empty string, and app/config.py
# supplies its in-code default. Vars consumed by the postgres and caddy
# images (POSTGRES_*, MCP_HOSTNAME, MCP_UPSTREAM, CADDY_*) and by the
# orchestrator's ports: block (MCP_PORT) must be set.
#
#   cp .env.example .env
#   ${EDITOR} .env             # set secrets, then:
#
# docker-compose:
#   docker compose --profile postgres --profile caddy up -d
#
# podman-kube-play (no wrapper script — plain envsubst is enough):
#   set -a; . ./.env; set +a
#   envsubst < podman-kube-play.yaml | podman kube play -
#
# Override individual values on the command line too:
#   EMBEDDING_API_KEY=sk-... envsubst < podman-kube-play.yaml | podman kube play -

# ---------------------------------------------------------------------------
# Vector database backend
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset (or set to a chroma:// URL) to use the embedded
# Chroma client; set it to a postgresql:// URL to use the in-pod PostgreSQL
# server.
DATABASE_URL=chroma://./chroma_data/chunks
# PostgreSQL + pgvector (uncomment to use the in-pod server):
# DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/gsrs_mcp

# ---------------------------------------------------------------------------
# PostgreSQL credentials (consumed by the postgres image itself; the app
# only needs them indirectly via DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=gsrs_mcp
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Embedding provider (consumed by the mcp-server image via app/config.py;
# all keys below are optional — unset keys fall back to the defaults
# defined in app/config.py)
# ---------------------------------------------------------------------------
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_VERIFY_SSL=true
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_MS=250

# Ollama example:
# EMBEDDING_API_KEY=ollama
# EMBEDDING_URL=http://host.docker.internal:11434/api/embed
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768

# ---------------------------------------------------------------------------
# MCP server transport and auth (optional — app/config.py has defaults)
# ---------------------------------------------------------------------------
MCP_TRANSPORT=streamable-http
MCP_API=0.0.0.0
MCP_PORT=8000
# Bearer token value for the /mcp endpoint when using streamable HTTP.
MCP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# GSRS upstream API tools (optional — app/config.py has defaults)
# ---------------------------------------------------------------------------
GSRS_API_URL=https://gsrs.ncats.nih.gov/api/v1
GSRS_API_TIMEOUT=30
GSRS_API_VERIFY_SSL=true
GSRS_API_MAX_RETRIES=1
GSRS_API_RETRY_BACKOFF_MS=250
GSRS_API_PUBLIC_ONLY=false

# ---------------------------------------------------------------------------
# Runtime / observability
# ---------------------------------------------------------------------------
DEFAULT_TOP_K=5
DEBUG_MODE=false
STARTUP_VALIDATE_EXTERNAL=false

# ---------------------------------------------------------------------------
# Chunker tuning (optional — app/config.py has defaults for every key)
# ---------------------------------------------------------------------------
CHUNKER_EMIT_ATOMIC_NAME_CHUNKS=true
CHUNKER_EMIT_SEQUENCE_SEGMENTS=false
CHUNKER_EMIT_FULL_SEQUENCE_IN_TEXT=true
CHUNKER_INCLUDE_ADMIN_VALIDATION_NOTES=true
CHUNKER_INCLUDE_CLASSIFICATION_CHUNK=true

# ---------------------------------------------------------------------------
# Caddy reverse proxy (consumed by the caddy container's startup script;
# required when the caddy profile / caddy container is started)
# ---------------------------------------------------------------------------
# Public DNS name resolving to the host running the stack. Caddy uses it to
# request a Let's Encrypt certificate via ACME HTTP-01, so ports 80 and 443
# must be reachable from the internet.
MCP_HOSTNAME=gsrs.example.com
# Upstream the reverse proxy forwards to. docker-compose defaults to the
# service hostname `mcp-server:8000`; kube defaults to `localhost:8000`
# because containers in a pod share a network namespace. Set this in
# .env (overrides the in-yaml default).
MCP_UPSTREAM=mcp-server:8000
# Optional: switch to Let's Encrypt staging to avoid rate limits while
# testing. Empty means use the production CA.
# https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=
# Optional: contact email passed to the ACME provider.
CADDY_EMAIL=
# MCP_UPSTREAM=localhost:8000
# Optional: switch to the Let's Encrypt staging directory while testing to
# avoid rate limits. Leave empty to use the production CA.
# CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Optional: contact email passed to the ACME provider. Leave empty to accept
# the Caddy default.
# CADDY_EMAIL=ops@example.com
